# 정점 (Vertex)
v -0.5 -0.5  0.5
v  0.5 -0.5  0.5
v  0.5  0.5  0.5
v -0.5  0.5  0.5
v -0.5 -0.5 -0.5
v  0.5 -0.5 -0.5
v  0.5  0.5 -0.5
v -0.5  0.5 -0.5

# UV 좌표 (전개도 3x3 십자 배치 기준)
# 1~4: 중앙 (앞면 - 출입구)
vt 0.36 0.36
vt 0.64 0.36
vt 0.64 0.64
vt 0.36 0.64

# 5~8: 좌측 (왼쪽 벽면 & 뒷면)
vt 0.06 0.36
vt 0.33 0.36
vt 0.33 0.64
vt 0.06 0.64

# 9~12: 우측 (오른쪽 벽면)
vt 0.67 0.36
vt 0.94 0.36
vt 0.94 0.64
vt 0.67 0.64

# 13~16: 상단 (지붕/옥상)
vt 0.36 0.67
vt 0.64 0.67
vt 0.64 0.94
vt 0.36 0.94

# 17~20: 하단 (바닥)
vt 0.36 0.06
vt 0.64 0.06
vt 0.64 0.33
vt 0.36 0.33

# 법선 (Normal)
vn  0.0  0.0  1.0
vn  0.0  0.0 -1.0
vn  0.0  1.0  0.0
vn  0.0 -1.0  0.0
vn  1.0  0.0  0.0
vn -1.0  0.0  0.0

# 면 (Face: 정점/UV/법선, 반시계 방향)
# 앞면 (+Z) -> 중앙
f 1/1/1 2/2/1 3/3/1
f 1/1/1 3/3/1 4/4/1

# 뒷면 (-Z) -> 좌측 벽면 재사용
f 6/5/2 5/6/2 8/7/2
f 6/5/2 8/7/2 7/8/2

# 윗면 (+Y) -> 상단 지붕
f 4/13/3 3/14/3 7/15/3
f 4/13/3 7/15/3 8/16/3

# 아랫면 (-Y) -> 하단 바닥
f 5/17/4 6/18/4 2/19/4
f 5/17/4 2/19/4 1/20/4

# 오른쪽 면 (+X) -> 우측 벽면
f 2/9/5 6/10/5 7/11/5
f 2/9/5 7/11/5 3/12/5

# 왼쪽 면 (-X) -> 좌측 벽면
f 5/5/6 1/6/6 4/7/6
f 5/5/6 4/7/6 8/8/6